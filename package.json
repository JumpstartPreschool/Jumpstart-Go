{
  "name": "jumpstart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "bash scripts/db-test.sh",
    "check:routing": "node --env-file=.env.local scripts/check-routing.ts",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "deploy:design": "VITE_DESIGN_PREVIEW=true npm run build && npx wrangler@4 deploy --name jumpstart-preschool-design"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
