{
  "name": "jumpstart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "bash scripts/db-test.sh",
    "check:routing": "node --env-file=.env.local scripts/check-routing.ts",
    "check:queries": "node --env-file=.env.local scripts/check-queries.ts",
    "deploy": "npm run check:queries && npm run build && env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID npx wrangler@4 deploy --env-file /dev/null"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "workbox-build": {
      "glob": "^13.0.6"
    }
  }
}
