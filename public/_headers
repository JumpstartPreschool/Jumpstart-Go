# Cloudflare response headers.
# CSP: the natural announcement voice (coordinator iPads) loads its model from Hugging Face and its runtime from
# jsDelivr, and compiles WebAssembly. X-Robots-Tag: a private app, so nothing is listed in search results except the
# Privacy Policy and Terms (see public/robots.txt).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(self), screen-wake-lock=(self), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, nofollow

/privacy
  ! X-Robots-Tag
/terms
  ! X-Robots-Tag

# Hashed build files never change, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and page must always be fresh, or updates would never arrive.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
