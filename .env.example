# Copy to .env.local and fill in. .env.local is git-ignored.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Database owner password (Supabase → Project Settings → Database). Scripts only; never used by the app.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=<project-ref>

# OpenRouteService key (openrouteservice.org → Dashboard). Server side only: set as a Supabase Edge Function secret.
ORS_API_KEY=

# Cloudflare publishing (scripts only): API token with Account → Workers Scripts → Edit, Account Settings → Read,
# User → User Details → Read and User → Memberships → Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Web push (VAPID). Make a pair with: node scripts/vapid-keys.mjs. The public key is for the app.
VITE_VAPID_PUBLIC_KEY=
# The private key is only a push-send function secret, never in the app or this file's copies in git.
VAPID_PRIVATE_KEY=

# Gate voice (D48, docs/architecture/voice-architecture.md). None of these go in the app: the first two are for the
# school computer running tts-service/, the rest are Supabase Edge Function secrets for `pronounce`.
# TTS_SHARED_SECRET: random, 32+ characters (openssl rand -hex 32); the same value on the school computer and in Supabase.
TTS_SHARED_SECRET=
# TTS_DEVICE: auto (GPU if present, else CPU), or mps, cuda, cpu.
TTS_DEVICE=auto
# TTS_SERVICE_URL: the school computer's Cloudflare Tunnel address, e.g. https://voice.jumpstartpreschool.in
TTS_SERVICE_URL=
# TTS_TUNNEL_TOKEN: optional, a named Cloudflare Tunnel's token (Zero Trust → Tunnels). With TTS_SERVICE_URL set, the
# voice uses that fixed address instead of a quick tunnel whose address changes on every start.
TTS_TUNNEL_TOKEN=
# VOICE_CRON_SECRET: random; also stored in app.voice_config so the database can ask `pronounce` to make clips.
VOICE_CRON_SECRET=
