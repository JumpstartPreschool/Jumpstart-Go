# Copy to .env.local and fill in. .env.local is git-ignored.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Database owner password (Supabase → Project Settings → Database). Scripts only; never used by the app.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=<project-ref>

# OpenRouteService key (openrouteservice.org → Dashboard). Server side only: set as a Supabase Edge Function secret.
ORS_API_KEY=

# Cloudflare publishing (scripts only): API token with Account → Workers Scripts → Edit, Account Settings → Read,
# User → User Details → Read and User → Memberships → Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Web push (VAPID). Make a pair with: node scripts/vapid-keys.mjs. The public key is for the app.
VITE_VAPID_PUBLIC_KEY=
# The private key is only a push-send function secret, never in the app or this file's copies in git.
VAPID_PRIVATE_KEY=

# Gate voice (D50, docs/architecture/voice-architecture.md): Supabase Edge Function secrets for `pronounce` only, never
# in the app. Azure portal → your Speech resource (Free F0) → Keys and Endpoint.
AZURE_SPEECH_KEY=
# The resource's region, e.g. centralindia (keeps the text in India).
AZURE_SPEECH_REGION=
# An Indian English female neural voice, e.g. en-IN-NeerjaNeural (also Aarti, Aashi, Ananya, Kavya).
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural
# Random; also stored in app.voice_config so the database's minute job can ask `pronounce` to make clips.
VOICE_CRON_SECRET=

# WhatsApp Business API via WATI (PRD D51, D52): Supabase Edge Function secrets ONLY.
# NEVER expose to frontend, never use VITE_ prefix.
# Set via: npx supabase secrets set WATI_API_TOKEN="..." WATI_API_BASE_URL="..."
WATI_API_TOKEN=
# Account base URL (e.g. https://live-server-XXXXX.wati.io or https://live-mt-server.wati.io)
WATI_API_BASE_URL=
# Optional: channel phone if account has multiple
WATI_CHANNEL=
# Supabase Auth Send SMS hook signature secret (Authentication -> Hooks -> Send SMS -> Secret)
SEND_SMS_HOOK_SECRET=
# Webhook secret key for wati-webhook status callbacks (?key=...)
WATI_WEBHOOK_SECRET=
# Template names (optional overrides; defaults to jumpstart_signin_code / jumpstart_invitation)
WATI_TEMPLATE_SIGNIN_CODE=
WATI_TEMPLATE_PASSWORD_RESET=
WATI_TEMPLATE_FAMILY_INVITATION=
WATI_TEMPLATE_STAFF_INVITATION=

